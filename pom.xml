<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.mikko</groupId>
  <artifactId>tomcat85-check</artifactId>
  <version>0.1.1</version>
  <packaging>jar</packaging>

  <name>tomcat85-check</name>
  <description>查出解压部署的 Tomcat 8.5 实际版本,并列出 Apache 声明影响 8.5 但 NVD 查不到的 CVE</description>

  <!--
    ⚠️ 本机 Maven 3.5.4(2018 年)卡死了插件版本 —— 见 docs/bets/5-spring-cloud-config.md:
       compiler 3.13 / surefire 3.x / jar 3.4 全都要求 Maven >= 3.6.3,
       而 Maven 自带的 compiler 3.1 不认 maven.compiler.release,会退回 source 5 编译失败。
    能用的交集就是下面这三个版本号,别升。
  -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- 运行时零依赖;JUnit 仅测试期 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>tomcat85-check</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.22.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>dev.mikko.tomcat85check.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
